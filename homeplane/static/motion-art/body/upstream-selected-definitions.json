    "skier-swing": {
      "id": "skier-swing",
      "he": "\u05ea\u05e0\u05d5\u05e4\u05ea \u05d2\u05d5\u05dc\u05e9 \u05e1\u05e7\u05d9",
      "en": "Skier arm swing",
      "amount": "15 \u05e4\u05e2\u05de\u05d9\u05dd",
      "steps": [
        "\u05d9\u05d3\u05d9\u05d9\u05dd \u05dc\u05de\u05e2\u05dc\u05d4 \u05de\u05e2\u05dc \u05d4\u05e8\u05d0\u05e9.",
        "\u05de\u05db\u05d5\u05e4\u05e4\u05d9\u05dd \u05d1\u05e8\u05db\u05d9\u05d9\u05dd \u05de\u05e2\u05d8, \u05d2\u05d5\u05e3 \u05e7\u05d3\u05d9\u05de\u05d4, \u05d9\u05d3\u05d9\u05d9\u05dd \u05de\u05ea\u05e0\u05d3\u05e0\u05d3\u05d5\u05ea \u05dc\u05d0\u05d7\u05d5\u05e8.",
        "\u05e2\u05d5\u05dc\u05d9\u05dd \u05d7\u05d6\u05e8\u05d4 \u05d5\u05d9\u05d3\u05d9\u05d9\u05dd \u05d7\u05d5\u05d6\u05e8\u05d5\u05ea \u05dc\u05de\u05e2\u05dc\u05d4.",
        "!\u05d2\u05d1 \u05d9\u05e9\u05e8. \u05d0\u05dd \u05d4\u05d2\u05d1 \u05e8\u05d2\u05d9\u05e9, \u05de\u05ea\u05db\u05d5\u05e4\u05e4\u05d9\u05dd \u05e4\u05d7\u05d5\u05ea."
      ],
      "amount_en": "15 reps",
      "steps_en": [
        "Raise your arms overhead.",
        "Bend your knees a little, lean forward, and swing your arms back.",
        "Come back up and bring your arms back overhead.",
        "!Keep your back straight. If your back is sensitive, bend less."
      ],
