    "side-step-arm-swing": {
      "id": "side-step-arm-swing",
      "he": "\u05e6\u05e2\u05d3 \u05dc\u05e6\u05d3 \u05e2\u05dd \u05e0\u05d3\u05e0\u05d5\u05d3 \u05d9\u05d3\u05d9\u05d9\u05dd",
      "en": "Side step with arm swings",
      "amount": "30 \u05e9\u05e0\u05d9\u05d5\u05ea",
      "steps": [
        "\u05e6\u05e2\u05d3 \u05d2\u05d3\u05d5\u05dc \u05d4\u05e6\u05d9\u05d3\u05d4, \u05d4\u05e8\u05d2\u05dc \u05d4\u05e9\u05e0\u05d9\u05d9\u05d4 \u05de\u05e6\u05d8\u05e8\u05e4\u05ea.",
        "\u05d4\u05d9\u05d3\u05d9\u05d9\u05dd \u05e0\u05e4\u05ea\u05d7\u05d5\u05ea \u05dc\u05e6\u05d3\u05d3\u05d9\u05dd \u05d1\u05db\u05dc \u05e6\u05e2\u05d3.",
        "\u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05dc\u05e6\u05d3 \u05d4\u05e9\u05e0\u05d9 \u05d1\u05e7\u05e6\u05d1 \u05e7\u05d1\u05d5\u05e2."
      ],
      "amount_en": "30 seconds",
      "steps_en": [
        "Take a big step to the side and bring the other foot in.",
        "Open your arms out to the sides with each step.",
        "Go back the other way at a steady pace."
