    "side-step-taps": {
      "id": "side-step-taps",
      "he": "\u05e6\u05e2\u05d3 \u05dc\u05e6\u05d3 \u05d5\u05d1\u05d7\u05d6\u05e8\u05d4",
      "en": "Side step taps",
      "amount": "10 \u05dc\u05db\u05dc \u05e6\u05d3",
      "steps": [
        "\u05e6\u05e2\u05d3 \u05e7\u05d8\u05df \u05dc\u05e6\u05d3, \u05e0\u05d5\u05d2\u05e2\u05d9\u05dd \u05d1\u05d1\u05d5\u05d4\u05df.",
        "\u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05dc\u05de\u05e8\u05db\u05d6 \u05d5\u05e2\u05d5\u05d1\u05e8\u05d9\u05dd \u05dc\u05e6\u05d3 \u05d4\u05e9\u05e0\u05d9.",
        "\u05d4\u05d9\u05d3\u05d9\u05d9\u05dd \u05e0\u05e4\u05ea\u05d7\u05d5\u05ea \u05dc\u05e6\u05d3\u05d3\u05d9\u05dd \u05d1\u05db\u05dc \u05e6\u05e2\u05d3."
      ],
      "amount_en": "10 each side",
      "steps_en": [
