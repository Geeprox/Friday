  "definitions": {
    "step-jack": {
      "id": "step-jack",
      "he": "\u05e6\u05e2\u05d3 \u05d4\u05e6\u05d9\u05d3\u05d4 \u05e2\u05dd \u05d9\u05d3\u05d9\u05d9\u05dd \u05dc\u05de\u05e2\u05dc\u05d4",
      "en": "Step jack",
      "amount": "20 \u05e4\u05e2\u05de\u05d9\u05dd",
      "steps": [
        "\u05db\u05de\u05d5 \u05e7\u05e4\u05d9\u05e6\u05ea \u05e4\u05d9\u05e1\u05d5\u05e7, \u05d0\u05d1\u05dc \u05d1\u05dc\u05d9 \u05dc\u05e7\u05e4\u05d5\u05e5.",
        "\u05e6\u05e2\u05d3 \u05e8\u05d2\u05dc \u05d0\u05d7\u05ea \u05d4\u05e6\u05d9\u05d3\u05d4 \u05d5\u05d1\u05de\u05e7\u05d1\u05d9\u05dc \u05d9\u05d3\u05d9\u05d9\u05dd \u05dc\u05de\u05e2\u05dc\u05d4.",
        "\u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05dc\u05de\u05e8\u05db\u05d6 \u05d5\u05de\u05d7\u05dc\u05d9\u05e4\u05d9\u05dd \u05e6\u05d3."
      ],
      "amount_en": "20 reps",
      "steps_en": [
        "Like a jumping jack, but with no jumping.",
        "Step one foot out to the side as you raise your arms.",
        "Come back to the center and switch sides."
      ],
