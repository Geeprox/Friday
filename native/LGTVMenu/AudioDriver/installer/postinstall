#!/bin/sh
set -eu
[ "$3" = / ] || exit 1
driver=/Library/Audio/Plug-Ins/HAL/LGTVAudio.driver
/usr/bin/codesign --verify --strict "$driver"
[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$driver/Contents/Info.plist")" = local.friday.LGTVAudio ]
/usr/sbin/chown -R root:wheel "$driver"
/bin/chmod -R go-w "$driver"
# Core Audio discovers HAL plug-ins on service start. Existing audio briefly stops.
/usr/bin/killall coreaudiod || true
exit 0
