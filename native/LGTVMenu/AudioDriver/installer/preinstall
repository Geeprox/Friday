#!/bin/sh
set -eu
[ "$3" = / ] || { echo "Install on the active startup volume only." >&2; exit 1; }
driver=/Library/Audio/Plug-Ins/HAL/LGTVAudio.driver
if [ -e "$driver" ]; then
    identifier=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$driver/Contents/Info.plist")
    [ "$identifier" = local.friday.LGTVAudio ] || { echo "Unrecognized component; leaving it unchanged." >&2; exit 1; }
    backup="/Library/Application Support/LGTVMenu/AudioBackups/$(date +%Y%m%d-%H%M%S)-$$.driver"
    /bin/mkdir -p "$(dirname "$backup")"
    /usr/bin/ditto "$driver" "$backup"
fi
# An upgrade must not strand output in a driver that is about to reload.
"$(dirname "$0")/Recovery" BuiltInSpeakerDevice </dev/null || true
exit 0
