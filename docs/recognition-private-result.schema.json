{
  "$defs": {
    "ObservationQuality": {
      "additionalProperties": false,
      "properties": {
        "evidence": {
          "const": "synthetic_owner_fixture",
          "default": "synthetic_owner_fixture",
          "title": "Evidence",
          "type": "string"
        },
        "qualified": {
          "title": "Qualified",
          "type": "boolean"
        },
        "pose_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pose Ok"
        },
        "sharpness_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharpness Ok"
        },
        "occlusion_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occlusion Ok"
        },
        "speech_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech Present"
        },
        "single_speaker": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Single Speaker"
        },
        "acoustic_quality_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acoustic Quality Ok"
        }
      },
      "required": [
        "qualified"
      ],
      "title": "ObservationQuality",
      "type": "object"
    },
    "ObservationTiming": {
      "additionalProperties": false,
      "properties": {
        "observed_monotonic": {
          "minimum": 0,
          "title": "Observed Monotonic",
          "type": "number"
        },
        "source_timestamp": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timestamp"
        },
        "source_clock_domain": {
          "const": "unverified",
          "default": "unverified",
          "title": "Source Clock Domain",
          "type": "string"
        },
        "observation_clock": {
          "const": "worker_monotonic",
          "default": "worker_monotonic",
          "title": "Observation Clock",
          "type": "string"
        },
        "capture_monotonic": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Monotonic"
        },
        "capture_clock_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Clock Id"
        },
        "av_sync": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Av Sync",
          "type": "string"
        },
        "capture_evidence": {
          "default": "unavailable",
          "enum": [
            "unavailable",
            "synthetic_owner_fixture"
          ],
          "title": "Capture Evidence",
          "type": "string"
        }
      },
      "required": [
        "observed_monotonic"
      ],
      "title": "ObservationTiming",
      "type": "object"
    },
    "RecognitionObservation": {
      "additionalProperties": false,
      "properties": {
        "observation_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Observation Id",
          "type": "string"
        },
        "modality": {
          "enum": [
            "face",
            "speaker"
          ],
          "title": "Modality",
          "type": "string"
        },
        "frame_sequence": {
          "default": 0,
          "maximum": 127,
          "minimum": 0,
          "title": "Frame Sequence",
          "type": "integer"
        },
        "face_slot": {
          "default": 0,
          "maximum": 7,
          "minimum": 0,
          "title": "Face Slot",
          "type": "integer"
        },
        "provenance": {
          "$ref": "#/$defs/RecognitionProvenance"
        },
        "quality": {
          "$ref": "#/$defs/ObservationQuality"
        },
        "timing": {
          "$ref": "#/$defs/ObservationTiming"
        },
        "track_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "tracking": {
          "default": "unavailable",
          "enum": [
            "unavailable",
            "unknown",
            "tentative",
            "confirmed"
          ],
          "title": "Tracking",
          "type": "string"
        },
        "embedding_produced": {
          "default": false,
          "title": "Embedding Produced",
          "type": "boolean"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "identity_claim": {
          "const": "none",
          "default": "none",
          "title": "Identity Claim",
          "type": "string"
        },
        "person_association": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Person Association",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "modality",
        "provenance",
        "quality",
        "timing"
      ],
      "title": "RecognitionObservation",
      "type": "object"
    },
    "RecognitionProvenance": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "enum": [
            "opencv_yunet_sface",
            "sherpa_wespeaker"
          ],
          "title": "Provider",
          "type": "string"
        },
        "embedding_model_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Embedding Model Sha256",
          "type": "string"
        },
        "detector_model_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detector Model Sha256"
        },
        "implementation_version": {
          "const": "friday-recognition/1",
          "default": "friday-recognition/1",
          "title": "Implementation Version",
          "type": "string"
        },
        "runtime_version": {
          "const": "synthetic-api-fake",
          "default": "synthetic-api-fake",
          "title": "Runtime Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "embedding_model_sha256"
      ],
      "title": "RecognitionProvenance",
      "type": "object"
    },
    "RecognitionSession": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "const": "recognition",
          "default": "recognition",
          "title": "Operation",
          "type": "string"
        },
        "session_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "owner_operation": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Owner Operation",
          "type": "string"
        },
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Camera Id",
          "type": "string"
        },
        "channel": {
          "const": 0,
          "default": 0,
          "title": "Channel",
          "type": "integer"
        },
        "modality": {
          "enum": [
            "face",
            "speaker"
          ],
          "title": "Modality",
          "type": "string"
        },
        "deadline_monotonic": {
          "exclusiveMinimum": 0,
          "title": "Deadline Monotonic",
          "type": "number"
        },
        "seconds": {
          "default": 2.0,
          "maximum": 8,
          "minimum": 2,
          "title": "Seconds",
          "type": "number"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "generation",
        "owner_operation",
        "camera_id",
        "modality",
        "deadline_monotonic",
        "simulated"
      ],
      "title": "RecognitionSession",
      "type": "object"
    },
    "RecognitionStatus": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "default": "disabled",
          "enum": [
            "disabled",
            "unavailable",
            "running",
            "ready",
            "unknown",
            "ambiguous",
            "matched",
            "expired"
          ],
          "title": "State",
          "type": "string"
        },
        "reason": {
          "default": "default_off",
          "enum": [
            "default_off",
            "owner_admission_unavailable",
            "owner_binding_mismatch",
            "running",
            "provider_unavailable",
            "quality_unqualified",
            "invalid_video",
            "invalid_audio",
            "audio_window_overflow",
            "short_audio",
            "no_input",
            "expired",
            "stopped",
            "configuration_changed",
            "stale_generation",
            "model_mismatch",
            "simulation_mismatch",
            "policy_unqualified",
            "candidate_unqualified",
            "below_threshold",
            "ambiguous",
            "similarity_evidence_only",
            "embedding_only",
            "native_failed",
            "worker_timeout",
            "worker_memory_limit",
            "worker_failed",
            "native_cleanup_uncertain"
          ],
          "title": "Reason",
          "type": "string"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        },
        "security_authentication": {
          "const": false,
          "default": false,
          "title": "Security Authentication",
          "type": "boolean"
        },
        "action_authorized": {
          "const": false,
          "default": false,
          "title": "Action Authorized",
          "type": "boolean"
        },
        "av_association": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Av Association",
          "type": "string"
        }
      },
      "title": "RecognitionStatus",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2,
      "default": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "session": {
      "$ref": "#/$defs/RecognitionSession"
    },
    "status": {
      "$ref": "#/$defs/RecognitionStatus"
    },
    "observation": {
      "anyOf": [
        {
          "$ref": "#/$defs/RecognitionObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "media_persisted": {
      "const": false,
      "default": false,
      "title": "Media Persisted",
      "type": "boolean"
    }
  },
  "required": [
    "session",
    "status"
  ],
  "title": "RecognitionResult",
  "type": "object"
}
