{
  "$defs": {
    "FeatureGroupProposal": {
      "additionalProperties": false,
      "properties": {
        "observation_ids": {
          "items": {
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        },
        "representative_ids": {
          "items": {
            "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Representative Ids",
          "type": "array"
        },
        "state": {
          "enum": [
            "candidate",
            "unknown",
            "ambiguous"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "observation_ids",
        "representative_ids",
        "state"
      ],
      "title": "FeatureGroupProposal",
      "type": "object"
    },
    "FeatureMetadataProposal": {
      "additionalProperties": false,
      "properties": {
        "action_authorized": {
          "const": false,
          "default": false,
          "title": "Action Authorized",
          "type": "boolean"
        },
        "base_people_revision": {
          "minimum": 0,
          "title": "Base People Revision",
          "type": "integer"
        },
        "embeddings_exported": {
          "const": false,
          "default": false,
          "title": "Embeddings Exported",
          "type": "boolean"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/FeatureGroupProposal"
          },
          "maxItems": 256,
          "title": "Groups",
          "type": "array"
        },
        "provenance": {
          "$ref": "#/$defs/RecognitionProvenance"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "session_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "generation",
        "base_people_revision",
        "provenance",
        "groups"
      ],
      "title": "FeatureMetadataProposal",
      "type": "object"
    },
    "ObservationQuality": {
      "additionalProperties": false,
      "properties": {
        "acoustic_quality_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Acoustic Quality Ok"
        },
        "evidence": {
          "const": "synthetic_owner_fixture",
          "default": "synthetic_owner_fixture",
          "title": "Evidence",
          "type": "string"
        },
        "occlusion_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Occlusion Ok"
        },
        "pose_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pose Ok"
        },
        "qualified": {
          "title": "Qualified",
          "type": "boolean"
        },
        "sharpness_ok": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sharpness Ok"
        },
        "single_speaker": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Single Speaker"
        },
        "speech_present": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speech Present"
        }
      },
      "required": [
        "qualified"
      ],
      "title": "ObservationQuality",
      "type": "object"
    },
    "ObservationTiming": {
      "additionalProperties": false,
      "properties": {
        "av_sync": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Av Sync",
          "type": "string"
        },
        "capture_clock_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Clock Id"
        },
        "capture_evidence": {
          "default": "unavailable",
          "enum": [
            "unavailable",
            "synthetic_owner_fixture"
          ],
          "title": "Capture Evidence",
          "type": "string"
        },
        "capture_monotonic": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capture Monotonic"
        },
        "observation_clock": {
          "const": "worker_monotonic",
          "default": "worker_monotonic",
          "title": "Observation Clock",
          "type": "string"
        },
        "observed_monotonic": {
          "minimum": 0,
          "title": "Observed Monotonic",
          "type": "number"
        },
        "source_clock_domain": {
          "const": "unverified",
          "default": "unverified",
          "title": "Source Clock Domain",
          "type": "string"
        },
        "source_timestamp": {
          "anyOf": [
            {
              "maximum": 18446744073709551615,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Timestamp"
        }
      },
      "required": [
        "observed_monotonic"
      ],
      "title": "ObservationTiming",
      "type": "object"
    },
    "RecognitionObservation": {
      "additionalProperties": false,
      "properties": {
        "embedding_produced": {
          "default": false,
          "title": "Embedding Produced",
          "type": "boolean"
        },
        "face_slot": {
          "default": 0,
          "maximum": 7,
          "minimum": 0,
          "title": "Face Slot",
          "type": "integer"
        },
        "frame_sequence": {
          "default": 0,
          "maximum": 127,
          "minimum": 0,
          "title": "Frame Sequence",
          "type": "integer"
        },
        "identity_claim": {
          "const": "none",
          "default": "none",
          "title": "Identity Claim",
          "type": "string"
        },
        "modality": {
          "enum": [
            "face",
            "speaker"
          ],
          "title": "Modality",
          "type": "string"
        },
        "observation_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Observation Id",
          "type": "string"
        },
        "person_association": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Person Association",
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/RecognitionProvenance"
        },
        "quality": {
          "$ref": "#/$defs/ObservationQuality"
        },
        "simulated": {
          "const": true,
          "default": true,
          "title": "Simulated",
          "type": "boolean"
        },
        "timing": {
          "$ref": "#/$defs/ObservationTiming"
        },
        "track_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Track Id"
        },
        "tracking": {
          "default": "unavailable",
          "enum": [
            "unavailable",
            "unknown",
            "tentative",
            "confirmed"
          ],
          "title": "Tracking",
          "type": "string"
        }
      },
      "required": [
        "observation_id",
        "modality",
        "provenance",
        "quality",
        "timing"
      ],
      "title": "RecognitionObservation",
      "type": "object"
    },
    "RecognitionProvenance": {
      "additionalProperties": false,
      "properties": {
        "detector_model_sha256": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Detector Model Sha256"
        },
        "embedding_model_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Embedding Model Sha256",
          "type": "string"
        },
        "implementation_version": {
          "const": "friday-recognition/1",
          "default": "friday-recognition/1",
          "title": "Implementation Version",
          "type": "string"
        },
        "provider": {
          "enum": [
            "opencv_yunet_sface",
            "sherpa_wespeaker"
          ],
          "title": "Provider",
          "type": "string"
        },
        "runtime_version": {
          "const": "synthetic-api-fake",
          "default": "synthetic-api-fake",
          "title": "Runtime Version",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "embedding_model_sha256"
      ],
      "title": "RecognitionProvenance",
      "type": "object"
    },
    "RecognitionSession": {
      "additionalProperties": false,
      "properties": {
        "camera_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[^\\x00-\\x1f]+$",
          "title": "Camera Id",
          "type": "string"
        },
        "channel": {
          "const": 0,
          "default": 0,
          "title": "Channel",
          "type": "integer"
        },
        "deadline_monotonic": {
          "exclusiveMinimum": 0,
          "title": "Deadline Monotonic",
          "type": "number"
        },
        "generation": {
          "minimum": 1,
          "title": "Generation",
          "type": "integer"
        },
        "modality": {
          "enum": [
            "face",
            "speaker"
          ],
          "title": "Modality",
          "type": "string"
        },
        "operation": {
          "const": "recognition",
          "default": "recognition",
          "title": "Operation",
          "type": "string"
        },
        "owner_operation": {
          "pattern": "^[A-Za-z0-9_-]{1,64}$",
          "title": "Owner Operation",
          "type": "string"
        },
        "seconds": {
          "default": 2.0,
          "maximum": 8,
          "minimum": 2,
          "title": "Seconds",
          "type": "number"
        },
        "session_id": {
          "pattern": "^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$",
          "title": "Session Id",
          "type": "string"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "generation",
        "owner_operation",
        "camera_id",
        "modality",
        "deadline_monotonic",
        "simulated"
      ],
      "title": "RecognitionSession",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "message_kind": {
      "const": "feature_metadata",
      "default": "feature_metadata",
      "title": "Message Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/FeatureMetadataProposal"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/RecognitionObservation"
      },
      "maxItems": 4,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    },
    "session": {
      "$ref": "#/$defs/RecognitionSession"
    }
  },
  "required": [
    "schema_version",
    "session",
    "metadata",
    "observations"
  ],
  "title": "FeatureMetadataMessage",
  "type": "object"
}
