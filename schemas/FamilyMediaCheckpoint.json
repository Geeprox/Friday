{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "binding_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Binding Fingerprint",
      "type": "string"
    },
    "directory_ref": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Directory Ref"
    },
    "scan_id": {
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
      "title": "Scan Id",
      "type": "string"
    },
    "next_cursor": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "entries_seen": {
      "minimum": 0,
      "title": "Entries Seen",
      "type": "integer"
    },
    "enumeration_complete": {
      "title": "Enumeration Complete",
      "type": "boolean"
    },
    "completed_scan_token": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Completed Scan Token"
    },
    "snapshot_consistent": {
      "const": false,
      "default": false,
      "title": "Snapshot Consistent",
      "type": "boolean"
    },
    "checked_at": {
      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    }
  },
  "required": [
    "binding_fingerprint",
    "scan_id",
    "entries_seen",
    "enumeration_complete",
    "checked_at"
  ],
  "title": "FamilyMediaCheckpoint",
  "type": "object"
}
