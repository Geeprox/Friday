{
  "$defs": {
    "CanonicalState": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "quality": {
          "enum": [
            "healthy",
            "suspect",
            "stale",
            "faulty",
            "unknown"
          ],
          "title": "Quality",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "selected_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Source"
        },
        "excluded_sources": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Excluded Sources",
          "type": "object"
        },
        "as_of": {
          "format": "date-time",
          "title": "As Of",
          "type": "string"
        },
        "valid_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until"
        },
        "resolver_version": {
          "default": "conservative-v1",
          "title": "Resolver Version",
          "type": "string"
        },
        "calibration_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Calibration Version"
        },
        "inferred": {
          "default": false,
          "title": "Inferred",
          "type": "boolean"
        },
        "value_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Interval"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Evidence Refs",
          "type": "array"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "quality",
        "reasons",
        "as_of"
      ],
      "title": "CanonicalState",
      "type": "object"
    },
    "MeasurementGroupView": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "entity": {
          "title": "Entity",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "primary_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Primary Key"
        },
        "source_keys": {
          "items": {
            "type": "string"
          },
          "title": "Source Keys",
          "type": "array"
        },
        "managed": {
          "title": "Managed",
          "type": "boolean"
        },
        "binding_valid": {
          "title": "Binding Valid",
          "type": "boolean"
        },
        "independence_basis": {
          "title": "Independence Basis",
          "type": "string"
        },
        "physical_independence_verified": {
          "const": false,
          "default": false,
          "title": "Physical Independence Verified",
          "type": "boolean"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalState"
            },
            {
              "type": "null"
            }
          ]
        },
        "calibration_status": {
          "enum": [
            "none",
            "active",
            "invalid",
            "expired"
          ],
          "title": "Calibration Status",
          "type": "string"
        },
        "calibration": {
          "anyOf": [
            {
              "$ref": "#/$defs/RelativeCalibration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "entity",
        "name",
        "location",
        "primary_key",
        "source_keys",
        "managed",
        "binding_valid",
        "independence_basis",
        "state",
        "calibration_status",
        "reasons"
      ],
      "title": "MeasurementGroupView",
      "type": "object"
    },
    "MeasurementProfile": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "entity": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entity",
          "type": "string"
        },
        "capability": {
          "default": "temperature",
          "maxLength": 64,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "unit": {
          "default": "\u00b0C",
          "maxLength": 24,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        },
        "location": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Location",
          "type": "string"
        },
        "placement": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Placement",
          "type": "string"
        },
        "installation_height_m": {
          "anyOf": [
            {
              "maximum": 10,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Installation Height M"
        },
        "reporting": {
          "pattern": "^(periodic_sample|change_triggered|latched_state|derived)$",
          "title": "Reporting",
          "type": "string"
        },
        "context": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "ttl_seconds": {
          "default": 300,
          "maximum": 3600,
          "minimum": 1,
          "title": "Ttl Seconds",
          "type": "integer"
        },
        "plausible_minimum": {
          "default": -40,
          "title": "Plausible Minimum",
          "type": "number"
        },
        "plausible_maximum": {
          "default": 85,
          "title": "Plausible Maximum",
          "type": "number"
        },
        "freeze_window_seconds": {
          "default": 60,
          "maximum": 3600,
          "minimum": 30,
          "title": "Freeze Window Seconds",
          "type": "integer"
        },
        "freeze_change": {
          "default": 2,
          "exclusiveMinimum": 0,
          "maximum": 20,
          "title": "Freeze Change",
          "type": "number"
        },
        "resolution": {
          "default": 0.1,
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Resolution",
          "type": "number"
        },
        "simulated": {
          "default": false,
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "entity",
        "location",
        "placement",
        "reporting",
        "context",
        "version"
      ],
      "title": "MeasurementProfile",
      "type": "object"
    },
    "MeasurementSource": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_key": {
          "title": "Source Key",
          "type": "string"
        },
        "binding_fingerprint": {
          "title": "Binding Fingerprint",
          "type": "string"
        },
        "entity_id": {
          "title": "Entity Id",
          "type": "string"
        },
        "physical_source_id": {
          "title": "Physical Source Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "room": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Room"
        },
        "unit": {
          "const": "\u00b0C",
          "default": "\u00b0C",
          "title": "Unit",
          "type": "string"
        },
        "capability": {
          "const": "temperature",
          "default": "temperature",
          "title": "Capability",
          "type": "string"
        },
        "configured": {
          "title": "Configured",
          "type": "boolean"
        },
        "binding_valid": {
          "title": "Binding Valid",
          "type": "boolean"
        },
        "profile": {
          "anyOf": [
            {
              "$ref": "#/$defs/MeasurementProfile"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "excluded_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excluded Until"
        },
        "excluded": {
          "default": false,
          "title": "Excluded",
          "type": "boolean"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/CanonicalState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        },
        "identity_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Identity Fingerprint"
        },
        "representativeness": {
          "default": "unreviewed",
          "enum": [
            "unreviewed",
            "room_reference",
            "contextual_air"
          ],
          "title": "Representativeness",
          "type": "string"
        }
      },
      "required": [
        "source_key",
        "binding_fingerprint",
        "entity_id",
        "physical_source_id",
        "name",
        "room",
        "configured",
        "binding_valid",
        "simulated"
      ],
      "title": "MeasurementSource",
      "type": "object"
    },
    "RelativeCalibration": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "reference": {
          "title": "Reference",
          "type": "string"
        },
        "source_profile": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Source Profile",
          "type": "string"
        },
        "reference_profile": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Reference Profile",
          "type": "string"
        },
        "context": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Context",
          "type": "string"
        },
        "version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Version",
          "type": "string"
        },
        "bias": {
          "title": "Bias",
          "type": "number"
        },
        "residual_bound": {
          "maximum": 10,
          "minimum": 0,
          "title": "Residual Bound",
          "type": "number"
        },
        "reference_minimum": {
          "title": "Reference Minimum",
          "type": "number"
        },
        "reference_maximum": {
          "title": "Reference Maximum",
          "type": "number"
        },
        "sample_count": {
          "maximum": 256,
          "minimum": 8,
          "title": "Sample Count",
          "type": "integer"
        },
        "valid_until": {
          "format": "date-time",
          "title": "Valid Until",
          "type": "string"
        },
        "relative_only": {
          "default": true,
          "title": "Relative Only",
          "type": "boolean"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        }
      },
      "required": [
        "source",
        "reference",
        "source_profile",
        "reference_profile",
        "context",
        "version",
        "bias",
        "residual_bound",
        "reference_minimum",
        "reference_maximum",
        "sample_count",
        "valid_until",
        "simulated"
      ],
      "title": "RelativeCalibration",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "realm": {
      "title": "Realm",
      "type": "string"
    },
    "revision": {
      "title": "Revision",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "simulated": {
      "title": "Simulated",
      "type": "boolean"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/MeasurementSource"
      },
      "maxItems": 256,
      "title": "Sources",
      "type": "array"
    },
    "omitted_count": {
      "minimum": 0,
      "title": "Omitted Count",
      "type": "integer"
    },
    "limits": {
      "items": {
        "type": "string"
      },
      "title": "Limits",
      "type": "array"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/MeasurementGroupView"
      },
      "maxItems": 16,
      "title": "Groups",
      "type": "array"
    }
  },
  "required": [
    "realm",
    "revision",
    "generated_at",
    "simulated",
    "sources",
    "omitted_count",
    "limits"
  ],
  "title": "MeasurementSettingsView",
  "type": "object"
}
