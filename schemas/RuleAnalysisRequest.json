{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "text": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "expected_context": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Context",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "record_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Record Ids",
      "type": "array"
    }
  },
  "required": [
    "text",
    "expected_context",
    "idempotency_key",
    "expires_at"
  ],
  "title": "RuleAnalysisRequest",
  "type": "object"
}
