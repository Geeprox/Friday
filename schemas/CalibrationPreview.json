    },
    "installed": {
      "const": false,
      "default": false,
      "title": "Installed",
      "type": "boolean"
    },
    "sample_history_persisted": {
      "const": false,
      "default": false,
      "title": "Sample History Persisted",
      "type": "boolean"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Evidence Refs",
      "type": "array"
    }
