{
  "$defs": {
    "FamilyMediaOriginalRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Source Ref",
          "type": "string"
        },
        "object_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Object Ref",
          "type": "string"
        },
        "config_generation": {
          "minimum": 0,
          "title": "Config Generation",
          "type": "integer"
        },
        "connection_epoch": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Connection Epoch",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Revision",
          "type": "string"
        },
        "revision_basis": {
          "const": "metadata",
          "default": "metadata",
          "title": "Revision Basis",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "object_ref",
        "config_generation",
        "connection_epoch",
        "revision"
      ],
      "title": "FamilyMediaOriginalRef",
      "type": "object"
    },
    "StewardSourceAnchor": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "content_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Id",
          "type": "string"
        },
        "original_ref": {
          "$ref": "#/$defs/FamilyMediaOriginalRef"
        },
        "kind": {
          "enum": [
            "file",
            "page",
            "image_region",
            "video_time",
            "audio_time"
          ],
          "title": "Kind",
          "type": "string"
        },
        "page": {
          "anyOf": [
            {
              "maximum": 100000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "start_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Ms"
        },
        "end_ms": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Ms"
        },
        "region": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        }
      },
      "required": [
        "content_id",
        "original_ref",
        "kind"
      ],
      "title": "StewardSourceAnchor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "unit_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Unit Id",
      "type": "string"
    },
    "ordinal": {
      "minimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "title": {
      "default": "",
      "maxLength": 120,
      "title": "Title",
      "type": "string"
    },
    "text": {
      "default": "",
      "maxLength": 4000,
      "title": "Text",
      "type": "string"
    },
    "anchor": {
      "$ref": "#/$defs/StewardSourceAnchor"
    },
    "provider": {
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
      "title": "Provider",
      "type": "string"
    },
    "provider_version": {
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
      "title": "Provider Version",
      "type": "string"
    }
  },
  "required": [
    "unit_id",
    "ordinal",
    "anchor",
    "provider",
    "provider_version"
  ],
  "title": "StewardUnit",
  "type": "object"
}
