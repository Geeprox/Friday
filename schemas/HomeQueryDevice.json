{
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "device",
      "title": "Kind",
      "type": "string"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "maxLength": 256,
      "pattern": "^[^\\x00-\\x1f\\x7f]*$",
      "title": "Name",
      "type": "string"
    },
    "room": {
      "anyOf": [
        {
          "maxLength": 128,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Room"
    },
    "category": {
      "enum": [
        "device",
        "service"
      ],
      "title": "Category",
      "type": "string"
    },
    "identity_basis": {
      "enum": [
        "xiaomi_identifier",
        "ha_device_registry",
        "simulated"
      ],
      "title": "Identity Basis",
      "type": "string"
    },
    "function_ids": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Function Ids",
      "type": "array"
    },
    "simulated": {
      "title": "Simulated",
      "type": "boolean"
    },
    "execution_authority": {
      "const": false,
      "title": "Execution Authority",
      "type": "boolean"
    }
  },
  "required": [
    "kind",
    "id",
    "name",
    "room",
    "category",
    "identity_basis",
    "function_ids",
    "simulated",
    "execution_authority"
  ],
  "title": "HomeQueryDevice",
  "type": "object"
}
