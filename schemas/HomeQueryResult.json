              "pattern": "^[^\\x00-\\x1f\\x7f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Device Name"
        },
        "name": {
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Name",
