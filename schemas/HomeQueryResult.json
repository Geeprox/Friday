          "title": "Valid Until"
        },
        "as_of_basis": {
          "const": "canonical_resolution_not_hardware_sample",
          "title": "As Of Basis",
          "type": "string"
        },
        "value_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value Interval"
        },
        "diagnostic_interval": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Diagnostic Interval"
        },
        "calibration_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Calibration Version"
        },
        "resolver_version": {
          "maxLength": 128,
          "title": "Resolver Version",
          "type": "string"
        },
        "inferred": {
          "title": "Inferred",
          "type": "boolean"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        },
        "confidence": {
          "title": "Confidence",
          "type": "null"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
