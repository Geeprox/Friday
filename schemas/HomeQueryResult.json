        "query_observed_at": {
          "format": "date-time",
          "title": "Query Observed At",
          "type": "string"
        },
        "hardware_sample_time": {
          "title": "Hardware Sample Time",
          "type": "null"
        },
        "causation_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Causation Ref"
        },
        "causation_status": {
          "enum": [
            "recorded_by_source_not_independently_verified",
            "unknown"
          ],
          "title": "Causation Status",
          "type": "string"
        },
        "correlation_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Correlation Ref"
        },
        "summary": {
          "maxProperties": 6,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "maximum": 1000000000000.0,
                  "minimum": -1000000000000.0,
                  "type": "integer"
                },
                {
                  "maximum": 1000000000000.0,
                  "minimum": -1000000000000.0,
                  "type": "number"
                },
                {
                  "maxLength": 256,
                  "pattern": "^[^\\x00-\\x1f\\x7f]*$",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "propertyNames": {
            "enum": [
              "from",
              "to",
              "quality",
              "status",
              "code",
              "reason"
