      "required": [
        "kind",
        "id",
        "source",
        "event_kind",
        "entity_refs",
        "event_time",
        "source_reported_at",
        "event_time_basis",
        "observed_at",
        "query_observed_at",
        "hardware_sample_time",
        "causation_ref",
        "causation_status",
        "correlation_ref",
        "summary",
        "simulated",
        "confidence"
      ],
      "title": "HomeQueryEvent",
      "type": "object"
