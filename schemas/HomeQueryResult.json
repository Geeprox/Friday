            {
              "maxLength": 128,
              "pattern": "^[^\\x00-\\x1f\\x7f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Room"
        },
        "capability": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Capability",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "maximum": 1000000000000.0,
              "minimum": -1000000000000.0,
              "type": "integer"
            },
            {
              "maximum": 1000000000000.0,
              "minimum": -1000000000000.0,
              "type": "number"
            },
            {
              "maxLength": 256,
              "pattern": "^[^\\x00-\\x1f\\x7f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
