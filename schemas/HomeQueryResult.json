          },
          "maxItems": 8,
          "title": "Source Times",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "id",
        "entity_id",
        "device_id",
        "device_name",
        "name",
        "room",
        "capability",
        "value",
        "unit",
        "quality",
        "freshness",
        "reasons",
        "selected_source",
        "excluded_sources",
        "as_of",
        "valid_until",
        "as_of_basis",
        "value_interval",
        "diagnostic_interval",
        "calibration_version",
        "resolver_version",
        "inferred",
        "simulated",
        "confidence",
        "evidence_refs",
        "source_times"
      ],
      "title": "HomeQueryState",
      "type": "object"
    }
