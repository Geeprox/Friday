        },
        "quality": {
          "enum": [
            "healthy",
            "suspect",
            "stale",
            "faulty",
            "unknown"
          ],
          "title": "Quality",
          "type": "string"
        },
        "freshness": {
          "enum": [
            "canonical_valid",
            "expired",
            "unknown"
          ],
          "title": "Freshness",
          "type": "string"
        },
        "reasons": {
          "items": {
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          "maxItems": 17,
          "title": "Reasons",
          "type": "array"
        },
        "selected_source": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Selected Source"
        },
        "excluded_sources": {
          "maxProperties": 8,
          "patternProperties": {
            "^[A-Za-z0-9][A-Za-z0-9_.:-]*$": {
