{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "empty",
        "refused"
      ],
      "title": "Status",
      "type": "string"
    },
    "code": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Code",
      "type": "string"
    },
    "kind": {
      "enum": [
        "state",
        "devices",
        "history",
        "evidence"
      ],
      "title": "Kind",
      "type": "string"
    },
    "source": {
      "default": "home",
      "enum": [
        "home",
        "family_media"
      ],
      "title": "Source",
      "type": "string"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "snapshot_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot At"
    },
    "snapshot_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Snapshot Ref"
    },
    "items": {
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/HomeQueryState"
          },
          {
            "$ref": "#/$defs/HomeQueryDevice"
          },
          {
            "$ref": "#/$defs/HomeQueryEvent"
          },
          {
            "$ref": "#/$defs/HomeQueryFamilyMediaEvidence"
          }
        ]
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 1024,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "coverage": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Coverage",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 12,
      "title": "Limitations",
      "type": "array"
    },
    "permission_scope": {
      "additionalProperties": false,
      "properties": {
        "subject": {
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Subject",
          "type": "string"
        },
        "boundary": {
          "enum": [
            "loopback_console",
            "registered_peer",
            "unverified"
          ],
          "title": "Boundary",
          "type": "string"
        },
        "revision": {
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Revision",
          "type": "string"
        },
        "requested_rooms": {
          "items": {
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Requested Rooms",
          "type": "array"
        },
        "requested_entities": {
          "items": {
            "maxLength": 256,
            "pattern": "^[^\\x00-\\x1f\\x7f]*$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Requested Entities",
          "type": "array"
        },
        "requested_source": {
          "default": "home",
          "enum": [
            "home",
            "family_media"
          ],
          "title": "Requested Source",
          "type": "string"
        },
        "requested_source_ref": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requested Source Ref"
        }
      },
      "required": [
        "subject",
        "boundary",
        "revision",
        "requested_rooms",
        "requested_entities"
      ],
      "title": "HomeQueryPermissionScope",
      "type": "object"
    },
    "simulated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Simulated"
    },
    "confidence": {
      "default": null,
      "title": "Confidence",
      "type": "null"
    },
    "confidence_basis": {
      "const": "not_statistically_calibrated",
      "default": "not_statistically_calibrated",
      "title": "Confidence Basis",
      "type": "string"
    },
    "execution_authority": {
      "const": false,
      "default": false,
      "title": "Execution Authority",
      "type": "boolean"
    },
    "household_media_sent": {
      "const": false,
      "default": false,
      "title": "Household Media Sent",
      "type": "boolean"
    },
    "sensitivity": {
      "const": "household",
      "default": "household",
      "title": "Sensitivity",
      "type": "string"
    }
  },
  "required": [
    "status",
    "code",
    "kind",
    "observed_at",
    "coverage",
    "permission_scope"
  ],
  "title": "HomeQueryResult",
  "type": "object",
  "$defs": {
    "FamilyMediaOriginalRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Source Ref",
          "type": "string"
        },
        "object_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Object Ref",
          "type": "string"
        },
        "config_generation": {
          "minimum": 0,
          "title": "Config Generation",
          "type": "integer"
        },
        "connection_epoch": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Connection Epoch",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Revision",
          "type": "string"
        },
        "revision_basis": {
          "const": "metadata",
          "default": "metadata",
          "title": "Revision Basis",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "object_ref",
        "config_generation",
        "connection_epoch",
        "revision"
      ],
      "title": "FamilyMediaOriginalRef",
      "type": "object"
    },
    "HomeQueryDevice": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "device",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "name": {
          "maxLength": 256,
          "pattern": "^[^\\x00-\\x1f\\x7f]*$",
          "title": "Name",
          "type": "string"
        },
        "room": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[^\\x00-\\x1f\\x7f]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Room"
        },
        "category": {
          "enum": [
            "device",
            "service"
          ],
          "title": "Category",
          "type": "string"
        },
        "identity_basis": {
          "enum": [
            "xiaomi_identifier",
            "ha_device_registry",
            "simulated"
          ],
          "title": "Identity Basis",
          "type": "string"
        },
        "function_ids": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Function Ids",
          "type": "array"
        },
        "simulated": {
          "title": "Simulated",
          "type": "boolean"
        },
        "execution_authority": {
          "const": false,
          "title": "Execution Authority",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "id",
        "name",
        "room",
        "category",
        "identity_basis",
        "function_ids",
        "simulated",
        "execution_authority"
      ],
      "title": "HomeQueryDevice",
      "type": "object"
    },
    "HomeQueryEvent": {
