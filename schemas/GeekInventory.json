        "fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "raw_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Raw Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "fingerprint",
        "raw_sha256"
      ],
      "title": "GeekGraph",
      "type": "object"
    },
