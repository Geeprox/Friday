{
  "$defs": {
    "BackgroundAttempt": {
      "additionalProperties": false,
      "description": "Last preparation result, distinct from the current owner's state.",
      "properties": {
        "checked_at": {
          "maxLength": 40,
          "title": "Checked At",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "connected",
            "failed"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "failure_phase": {
          "anyOf": [
            {
              "enum": [
                "local_setup",
                "websocket_connect",
                "authenticate",
                "inventory"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Phase"
        },
        "failure_code": {
          "anyOf": [
            {
              "enum": [
                "connection_refused",
                "network_unreachable",
                "gateway_closed_connection",
                "connection_timeout",
                "websocket_upgrade_rejected",
                "authentication_timeout",
                "protocol_selection_failed",
                "authentication_handshake_failed",
                "gateway_error_frame",
                "unexpected_handshake_frame",
                "readonly_request_timeout",
                "session_not_connected",
                "check_failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure Code"
        },
        "network_errno": {
          "anyOf": [
            {
              "enum": [
                "ECONNREFUSED",
                "ETIMEDOUT",
                "EHOSTUNREACH",
                "ENETUNREACH",
                "EPERM",
                "EACCES"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Network Errno"
        }
      },
      "required": [
        "checked_at",
        "outcome"
      ],
      "title": "BackgroundAttempt",
      "type": "object"
    },
    "Changes": {
      "additionalProperties": false,
      "properties": {
        "added": {
          "maximum": 64,
          "minimum": 0,
          "title": "Added",
          "type": "integer"
        },
        "removed": {
          "maximum": 64,
          "minimum": 0,
          "title": "Removed",
          "type": "integer"
        },
        "modified": {
          "maximum": 64,
          "minimum": 0,
          "title": "Modified",
          "type": "integer"
        }
      },
      "required": [
        "added",
        "removed",
        "modified"
      ],
      "title": "Changes",
      "type": "object"
    },
    "GeekGraph": {
