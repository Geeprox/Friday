{
  "$defs": {
    "FamilyMediaOriginalRef": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Source Ref",
          "type": "string"
        },
        "object_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Object Ref",
          "type": "string"
        },
        "config_generation": {
          "minimum": 0,
          "title": "Config Generation",
          "type": "integer"
        },
        "connection_epoch": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Connection Epoch",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Revision",
          "type": "string"
        },
        "revision_basis": {
          "const": "metadata",
          "default": "metadata",
          "title": "Revision Basis",
          "type": "string"
        }
      },
      "required": [
        "source_ref",
        "object_ref",
        "config_generation",
        "connection_epoch",
        "revision"
      ],
      "title": "FamilyMediaOriginalRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "item_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Item Id",
      "type": "string"
    },
    "media_kind": {
      "enum": [
        "image",
        "video"
      ],
      "title": "Media Kind",
      "type": "string"
    },
    "status": {
      "enum": [
        "ready",
        "pending",
        "missing",
        "stale",
        "unavailable"
      ],
      "title": "Status",
      "type": "string"
    },
    "last_seen_at": {
      "format": "date-time",
      "title": "Last Seen At",
      "type": "string"
    },
    "original_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/FamilyMediaOriginalRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "item_id",
    "media_kind",
    "status",
    "last_seen_at",
    "original_ref"
  ],
  "title": "HomeQueryFamilyMediaOriginal",
  "type": "object"
}
