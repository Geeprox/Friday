{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "source_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ref"
    },
    "config_generation": {
      "minimum": 0,
      "title": "Config Generation",
      "type": "integer"
    },
    "connection_epoch": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connection Epoch"
    },
    "configured": {
      "default": false,
      "title": "Configured",
      "type": "boolean"
    },
    "enabled": {
      "default": false,
      "title": "Enabled",
      "type": "boolean"
    },
    "state": {
      "enum": [
        "not_configured",
        "disabled",
        "connecting",
        "online",
        "backoff",
        "paused",
        "stopped"
      ],
      "title": "State",
      "type": "string"
    },
    "reachable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reachable"
    },
    "authenticated": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authenticated"
    },
    "readable": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Readable"
    },
    "failure": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure"
    },
    "retry_in_seconds": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retry In Seconds"
    },
    "checked_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked At"
    }
  },
  "required": [
    "config_generation",
    "state"
  ],
  "title": "NASConnectionStatus",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
