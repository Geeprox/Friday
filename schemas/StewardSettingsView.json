{
  "$defs": {
    "StewardBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_bytes": {
          "default": 1048576,
          "maximum": 8388608,
          "minimum": 1,
          "title": "Source Bytes",
          "type": "integer"
        },
        "units": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Units",
          "type": "integer"
        },
        "seconds": {
          "default": 5,
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Seconds",
          "type": "number"
        },
        "text_chars": {
          "default": 32000,
          "maximum": 32000,
          "minimum": 1,
          "title": "Text Chars",
          "type": "integer"
        }
      },
      "title": "StewardBudget",
      "type": "object"
    },
    "StewardDirectorySettings": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "settings_id": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Settings Id",
          "type": "string"
        },
        "source_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Source Ref",
          "type": "string"
        },
        "config_generation": {
          "minimum": 0,
          "title": "Config Generation",
          "type": "integer"
        },
        "connection_epoch": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Connection Epoch",
          "type": "string"
        },
        "directory_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Directory Ref"
        },
        "watched": {
          "default": false,
          "title": "Watched",
          "type": "boolean"
        },
        "extraction_mode": {
          "default": "metadata_only",
          "enum": [
            "metadata_only",
            "pdf_text_first"
          ],
          "title": "Extraction Mode",
          "type": "string"
        },
        "budget": {
          "$ref": "#/$defs/StewardBudget"
        },
        "policy_rule_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Policy Rule Id",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "settings_id",
        "source_ref",
        "config_generation",
        "connection_epoch",
        "directory_ref",
        "policy_rule_id",
        "updated_at"
      ],
      "title": "StewardDirectorySettings",
      "type": "object"
    },
    "StewardPolicyResolution": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "fingerprint": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Fingerprint",
          "type": "string"
        },
        "source": {
          "enum": [
            "file_exception",
            "directory_policy",
            "default_preserve",
            "policy_conflict"
          ],
          "title": "Source",
          "type": "string"
        },
        "matched_rule_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
            "type": "string"
          },
          "title": "Matched Rule Ids",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "rename_preview": {
          "default": false,
          "title": "Rename Preview",
          "type": "boolean"
        },
        "move_preview": {
          "default": false,
          "title": "Move Preview",
          "type": "boolean"
        },
        "structure_preview": {
          "default": false,
          "title": "Structure Preview",
          "type": "boolean"
        },
        "dedup_review": {
          "default": false,
          "title": "Dedup Review",
          "type": "boolean"
        },
        "bundle_review_required": {
          "default": false,
          "title": "Bundle Review Required",
          "type": "boolean"
        },
        "automatic_cloud_allowed": {
          "const": false,
          "default": false,
          "title": "Automatic Cloud Allowed",
          "type": "boolean"
        }
      },
      "required": [
        "fingerprint",
        "source",
        "matched_rule_ids",
        "label"
      ],
      "title": "StewardPolicyResolution",
      "type": "object"
    },
    "StewardPolicyRule": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Rule Id",
          "type": "string"
        },
        "source_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Source Ref",
          "type": "string"
        },
        "config_generation": {
          "minimum": 0,
          "title": "Config Generation",
          "type": "integer"
        },
        "connection_epoch": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Connection Epoch",
          "type": "string"
        },
        "directory_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Directory Ref"
        },
        "item_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "user_pinned"
          ],
          "title": "Status",
          "type": "string"
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "unknown",
            "camera_phone",
            "downloaded",
            "old_photos",
            "sensitive",
            "bundle"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rename_preview": {
          "default": false,
          "title": "Rename Preview",
          "type": "boolean"
        },
        "move_preview": {
          "default": false,
          "title": "Move Preview",
          "type": "boolean"
        },
        "structure_preview": {
          "default": false,
          "title": "Structure Preview",
          "type": "boolean"
        },
        "dedup_review": {
          "default": false,
          "title": "Dedup Review",
          "type": "boolean"
        },
        "unit": {
          "default": "file",
          "enum": [
            "file",
            "dependent_bundle"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "source_ref",
        "config_generation",
        "connection_epoch",
        "label"
      ],
      "title": "StewardPolicyRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "settings": {
      "$ref": "#/$defs/StewardDirectorySettings"
    },
    "rule": {
      "$ref": "#/$defs/StewardPolicyRule"
    },
    "effective_policy": {
      "$ref": "#/$defs/StewardPolicyResolution"
    },
    "fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "saved": {
      "title": "Saved",
      "type": "boolean"
    },
    "activation": {
      "const": "held",
      "default": "held",
      "title": "Activation",
      "type": "string"
    },
    "source_grant_verified": {
      "const": false,
      "default": false,
      "title": "Source Grant Verified",
      "type": "boolean"
    },
    "scan_started": {
      "const": false,
      "default": false,
      "title": "Scan Started",
      "type": "boolean"
    },
    "extraction_started": {
      "const": false,
      "default": false,
      "title": "Extraction Started",
      "type": "boolean"
    }
  },
  "required": [
    "settings",
    "rule",
    "effective_policy",
    "fingerprint",
    "saved"
  ],
  "title": "StewardSettingsView",
  "type": "object"
}
