          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Object Ref",
          "type": "string"
        },
        "config_generation": {
          "minimum": 0,
          "title": "Config Generation",
          "type": "integer"
        },
        "connection_epoch": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Connection Epoch",
          "type": "string"
        },
        "revision": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Revision",
          "type": "string"
        },
        "revision_basis": {
          "const": "metadata",
          "default": "metadata",
