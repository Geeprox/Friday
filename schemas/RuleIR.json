{
  "$defs": {
    "CancelInstruction": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "cancel_pending",
          "default": "cancel_pending",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "scope": {
          "const": "same_rule",
          "default": "same_rule",
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "CancelInstruction",
      "type": "object"
    },
    "ClimateInstruction": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "climate.set",
          "default": "climate.set",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "power": {
          "enum": [
            "on",
            "off"
          ],
          "title": "Power",
          "type": "string"
        }
      },
      "required": [
        "id",
        "target",
        "power"
      ],
      "title": "ClimateInstruction",
      "type": "object"
    },
    "DecisionCondition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "decision",
          "default": "decision",
          "title": "Type",
          "type": "string"
        },
        "provider": {
          "enum": [
            "laya_mlx",
            "jev",
            "openai_decisions"
          ],
          "title": "Provider",
          "type": "string"
        },
        "task": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Task",
          "type": "string"
        },
        "equals": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Equals",
          "type": "string"
        },
        "require_valid_lease": {
          "const": true,
          "default": true,
          "title": "Require Valid Lease",
          "type": "boolean"
        }
      },
      "required": [
        "provider",
        "task",
        "equals"
      ],
      "title": "DecisionCondition",
      "type": "object"
    },
    "DelayInstruction": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "delay",
          "default": "delay",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "milliseconds": {
          "maximum": 30000,
          "minimum": 1,
          "title": "Milliseconds",
          "type": "integer"
        },
        "cancel_on_new_event": {
          "const": true,
          "default": true,
          "title": "Cancel On New Event",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "milliseconds"
      ],
      "title": "DelayInstruction",
      "type": "object"
    },
    "DeviceInstruction": {
      "additionalProperties": false,
      "description": "Absolute shared operation; no raw HA services or implicit climate mode.",
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "device.set",
          "default": "device.set",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "operation": {
          "enum": [
            "light.set",
            "switch.set",
            "fan.set",
            "fan.percentage",
            "climate.mode",
            "climate.temperature",
            "cover.position",
            "cover.state",
            "lock.set",
            "number.value",
            "select.option"
          ],
          "title": "Operation",
          "type": "string"
        },
        "desired": {
          "additionalProperties": true,
          "title": "Desired",
          "type": "object"
        }
      },
      "required": [
        "id",
        "target",
        "operation",
        "desired"
      ],
      "title": "DeviceInstruction",
      "type": "object"
    },
    "EventTrigger": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "event",
          "default": "event",
          "title": "Type",
          "type": "string"
        },
        "entity": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entity",
          "type": "string"
        },
        "capability": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "entity",
        "capability",
        "value"
      ],
      "title": "EventTrigger",
      "type": "object"
    },
    "FeedbackInstruction": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "feedback.speak",
          "default": "feedback.speak",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "endpoint": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "route": {
          "enum": [
            "local_tts",
            "cloud_tts"
          ],
          "title": "Route",
          "type": "string"
        },
        "text": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "endpoint",
        "route",
        "text"
      ],
      "title": "FeedbackInstruction",
      "type": "object"
    },
    "LightInstruction": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "light.set",
          "default": "light.set",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "target": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Target",
          "type": "string"
        },
        "power": {
          "enum": [
            "on",
            "off"
          ],
          "title": "Power",
          "type": "string"
        },
        "brightness": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "const": "minimum_verified",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Brightness"
        },
        "require_no_bright_flash": {
          "default": false,
          "title": "Require No Bright Flash",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "target",
        "power"
      ],
      "title": "LightInstruction",
      "type": "object"
    },
    "ModeCondition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "mode",
          "default": "mode",
          "title": "Type",
          "type": "string"
        },
        "mode": {
          "enum": [
            "home.sleep",
            "home.manual",
            "home.present"
          ],
          "title": "Mode",
          "type": "string"
        },
        "equals": {
          "title": "Equals",
          "type": "boolean"
        },
        "require_valid_lease": {
          "const": true,
          "default": true,
          "title": "Require Valid Lease",
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "equals"
      ],
      "title": "ModeCondition",
      "type": "object"
    },
    "NumericCondition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "numeric",
          "default": "numeric",
          "title": "Type",
          "type": "string"
        },
        "entity": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entity",
          "type": "string"
        },
        "capability": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "operator": {
          "enum": [
            "lt",
            "le",
            "gt",
            "ge",
            "eq"
          ],
          "title": "Operator",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 24,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "entity",
        "capability",
        "operator",
        "value"
      ],
      "title": "NumericCondition",
      "type": "object"
    },
    "RuleExecution": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "preferred_backend": {
          "default": "simulator",
          "enum": [
            "simulator",
            "home_core",
            "ha",
            "mijia_geek"
          ],
          "title": "Preferred Backend",
          "type": "string"
        },
        "require_wan_independent": {
          "default": false,
          "title": "Require Wan Independent",
          "type": "boolean"
        },
        "require_core_independent": {
          "default": false,
          "title": "Require Core Independent",
          "type": "boolean"
        },
        "replay_policy": {
          "const": "never_actuate",
          "default": "never_actuate",
          "title": "Replay Policy",
          "type": "string"
        },
        "max_event_age_ms": {
          "default": 3000,
          "maximum": 30000,
          "minimum": 1,
          "title": "Max Event Age Ms",
          "type": "integer"
        }
      },
      "title": "RuleExecution",
      "type": "object"
    },
    "RuleSafety": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "policy_ref": {
          "default": "policy.managed-lighting.v1",
          "maxLength": 128,
          "minLength": 1,
          "title": "Policy Ref",
          "type": "string"
        },
        "prohibited_targets": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Prohibited Targets",
          "type": "array"
        },
        "respect_sleep": {
          "const": true,
          "default": true,
          "title": "Respect Sleep",
          "type": "boolean"
        },
        "respect_manual_override": {
          "const": true,
          "default": true,
          "title": "Respect Manual Override",
          "type": "boolean"
        },
        "allow_during_sleep": {
          "default": false,
          "title": "Allow During Sleep",
          "type": "boolean"
        }
      },
      "title": "RuleSafety",
      "type": "object"
    },
    "TimeCondition": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "time_window",
          "default": "time_window",
          "title": "Type",
          "type": "string"
        },
        "start": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "Start",
          "type": "string"
        },
        "end": {
          "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
          "title": "End",
          "type": "string"
        },
        "timezone": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end",
        "timezone"
      ],
      "title": "TimeCondition",
      "type": "object"
    },
    "TransitionTrigger": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "type": {
          "const": "state_transition",
          "default": "state_transition",
          "title": "Type",
          "type": "string"
        },
        "entity": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Entity",
          "type": "string"
        },
        "capability": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Capability",
          "type": "string"
        },
        "from_value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "From Value"
        },
        "to_value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "To Value"
        }
      },
      "required": [
        "entity",
        "capability",
        "from_value",
        "to_value"
      ],
      "title": "TransitionTrigger",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "intent": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Intent",
      "type": "string"
    },
    "ownership": {
      "const": "managed",
      "default": "managed",
      "title": "Ownership",
      "type": "string"
    },
    "trigger": {
      "discriminator": {
        "mapping": {
          "event": "#/$defs/EventTrigger",
          "state_transition": "#/$defs/TransitionTrigger"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/TransitionTrigger"
        },
        {
          "$ref": "#/$defs/EventTrigger"
        }
      ],
      "title": "Trigger"
    },
    "conditions": {
      "items": {
        "discriminator": {
          "mapping": {
            "decision": "#/$defs/DecisionCondition",
            "mode": "#/$defs/ModeCondition",
            "numeric": "#/$defs/NumericCondition",
            "time_window": "#/$defs/TimeCondition"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/NumericCondition"
          },
          {
            "$ref": "#/$defs/ModeCondition"
          },
          {
            "$ref": "#/$defs/TimeCondition"
          },
          {
            "$ref": "#/$defs/DecisionCondition"
          }
        ]
      },
      "maxItems": 8,
      "title": "Conditions",
      "type": "array"
    },
    "on_unknown": {
      "const": "suppress_and_record",
      "default": "suppress_and_record",
      "title": "On Unknown",
      "type": "string"
    },
    "actions": {
      "items": {
        "discriminator": {
          "mapping": {
            "cancel_pending": "#/$defs/CancelInstruction",
            "climate.set": "#/$defs/ClimateInstruction",
            "delay": "#/$defs/DelayInstruction",
            "device.set": "#/$defs/DeviceInstruction",
            "feedback.speak": "#/$defs/FeedbackInstruction",
            "light.set": "#/$defs/LightInstruction"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/LightInstruction"
          },
          {
            "$ref": "#/$defs/ClimateInstruction"
          },
          {
            "$ref": "#/$defs/DeviceInstruction"
          },
          {
            "$ref": "#/$defs/DelayInstruction"
          },
          {
            "$ref": "#/$defs/CancelInstruction"
          },
          {
            "$ref": "#/$defs/FeedbackInstruction"
          }
        ]
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Actions",
      "type": "array"
    },
    "execution": {
      "$ref": "#/$defs/RuleExecution"
    },
    "safety": {
      "$ref": "#/$defs/RuleSafety"
    },
    "simulated": {
      "default": false,
      "title": "Simulated",
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "revision",
    "intent",
    "trigger",
    "actions"
  ],
  "title": "RuleIR",
  "type": "object"
}
