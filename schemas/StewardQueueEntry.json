{
  "$defs": {
    "StewardBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_bytes": {
          "default": 1048576,
          "maximum": 8388608,
          "minimum": 1,
          "title": "Source Bytes",
          "type": "integer"
        },
        "units": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Units",
          "type": "integer"
        },
        "seconds": {
          "default": 5,
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Seconds",
          "type": "number"
        },
        "text_chars": {
          "default": 32000,
          "maximum": 32000,
          "minimum": 1,
          "title": "Text Chars",
          "type": "integer"
        }
      },
      "title": "StewardBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "job_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Job Id",
      "type": "string"
    },
    "settings_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Settings Fingerprint",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/StewardBudget"
    },
    "status": {
      "enum": [
        "held",
        "waiting",
        "claimed",
        "paused",
        "done",
        "needs_ocr",
        "cancelled",
        "failed",
        "offline",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "reason": {
      "maxLength": 120,
      "title": "Reason",
      "type": "string"
    },
    "revision": {
      "default": 0,
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "lease_token": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Token"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    }
  },
  "required": [
    "job_id",
    "settings_fingerprint",
    "budget",
    "status",
    "reason",
    "created_at",
    "updated_at"
  ],
  "title": "StewardQueueEntry",
  "type": "object"
}
