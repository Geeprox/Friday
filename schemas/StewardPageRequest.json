        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "limit": {
      "default": 50,
      "maximum": 100,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "query": {
      "default": "",
      "maxLength": 120,
      "title": "Query",
      "type": "string"
    },
    "search_mode": {
      "default": "catalog_page",
      "enum": [
        "catalog_page",
        "indexed_cache"
      ],
      "title": "Search Mode",
      "type": "string"
    }
