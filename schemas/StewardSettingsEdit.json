{
  "$defs": {
    "StewardBudget": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "source_bytes": {
          "default": 1048576,
          "maximum": 8388608,
          "minimum": 1,
          "title": "Source Bytes",
          "type": "integer"
        },
        "units": {
          "default": 8,
          "maximum": 8,
          "minimum": 1,
          "title": "Units",
          "type": "integer"
        },
        "seconds": {
          "default": 5,
          "exclusiveMinimum": 0,
          "maximum": 5,
          "title": "Seconds",
          "type": "number"
        },
        "text_chars": {
          "default": 32000,
          "maximum": 32000,
          "minimum": 1,
          "title": "Text Chars",
          "type": "integer"
        }
      },
      "title": "StewardBudget",
      "type": "object"
    },
    "StewardPolicyRule": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "rule_id": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Rule Id",
          "type": "string"
        },
        "source_ref": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Source Ref",
          "type": "string"
        },
        "config_generation": {
          "minimum": 0,
          "title": "Config Generation",
          "type": "integer"
        },
        "connection_epoch": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "title": "Connection Epoch",
          "type": "string"
        },
        "directory_ref": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Directory Ref"
        },
        "item_id": {
          "anyOf": [
            {
              "pattern": "^[a-f0-9]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Id"
        },
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "status": {
          "default": "proposed",
          "enum": [
            "proposed",
            "user_pinned"
          ],
          "title": "Status",
          "type": "string"
        },
        "origin": {
          "default": "unknown",
          "enum": [
            "unknown",
            "camera_phone",
            "downloaded",
            "old_photos",
            "sensitive",
            "bundle"
          ],
          "title": "Origin",
          "type": "string"
        },
        "rename_preview": {
          "default": false,
          "title": "Rename Preview",
          "type": "boolean"
        },
        "move_preview": {
          "default": false,
          "title": "Move Preview",
          "type": "boolean"
        },
        "structure_preview": {
          "default": false,
          "title": "Structure Preview",
          "type": "boolean"
        },
        "dedup_review": {
          "default": false,
          "title": "Dedup Review",
          "type": "boolean"
        },
        "unit": {
          "default": "file",
          "enum": [
            "file",
            "dependent_bundle"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "rule_id",
        "source_ref",
        "config_generation",
        "connection_epoch",
        "label"
      ],
      "title": "StewardPolicyRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "expected_context": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Context",
      "type": "string"
    },
    "sample_item_id": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Sample Item Id",
      "type": "string"
    },
    "expected_fingerprint": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Fingerprint",
      "type": "string"
    },
    "watched": {
      "title": "Watched",
      "type": "boolean"
    },
    "extraction_mode": {
      "enum": [
        "metadata_only",
        "pdf_text_first"
      ],
      "title": "Extraction Mode",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/StewardBudget"
    },
    "rule": {
      "$ref": "#/$defs/StewardPolicyRule"
    }
  },
  "required": [
    "expected_context",
    "sample_item_id",
    "expected_fingerprint",
    "watched",
    "extraction_mode",
    "budget",
    "rule"
  ],
  "title": "StewardSettingsEdit",
  "type": "object"
}
