{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "text": {
      "maxLength": 1024,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "expected_context": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Expected Context",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "record_id": {
      "anyOf": [
        {
          "maxLength": 192,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Record Id"
    },
    "action_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Action Id"
    },
    "expected_fingerprint": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Fingerprint"
    }
  },
  "required": [
    "text",
    "expected_context",
    "idempotency_key",
    "expires_at"
  ],
  "title": "RuleTextRequest",
  "type": "object"
}
