{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "kind": {
      "enum": [
        "state",
        "devices",
        "history",
        "evidence"
      ],
      "title": "Kind",
      "type": "string"
    },
    "source": {
      "default": "home",
      "enum": [
        "home",
        "family_media"
      ],
      "title": "Source",
      "type": "string"
    },
    "source_ref": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Ref"
    },
    "expected_context": {
      "anyOf": [
        {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Context"
    },
    "rooms": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[^\\x00-\\x1f\\x7f]*$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Rooms",
      "type": "array",
      "uniqueItems": true
    },
    "entities": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Entities",
      "type": "array",
      "uniqueItems": true
    },
    "capabilities": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Capabilities",
      "type": "array",
      "uniqueItems": true
    },
    "evidence_refs": {
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 16,
      "title": "Evidence Refs",
      "type": "array",
      "uniqueItems": true
    },
    "start": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Start"
    },
    "end": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "End"
    },
    "limit": {
      "default": 20,
      "maximum": 50,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "timeout_ms": {
      "default": 3000,
      "maximum": 3000,
      "minimum": 10,
      "title": "Timeout Ms",
      "type": "integer"
    }
  },
  "required": [
    "kind"
  ],
  "title": "HomeQuery",
  "type": "object"
}
