{
  "$defs": {
    "StewardNativeTextQuality": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "embedded_chars": {
          "default": 0,
          "maximum": 1000000,
          "minimum": 0,
          "title": "Embedded Chars",
          "type": "integer"
        },
        "meaningful_chars": {
          "default": 0,
          "maximum": 4000,
          "minimum": 0,
          "title": "Meaningful Chars",
          "type": "integer"
        },
        "flags": {
          "items": {
            "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
            "type": "string"
          },
          "maxItems": 8,
          "title": "Flags",
          "type": "array"
        },
        "ocr_min_confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ocr Min Confidence"
        }
      },
      "title": "StewardNativeTextQuality",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Provider owner's small native wire; distinct from embedded-only PDF wrapper.",
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "receipt_version": {
      "const": 2,
      "default": 2,
      "title": "Receipt Version",
      "type": "integer"
    },
    "page": {
      "maximum": 256,
      "minimum": 1,
      "title": "Page",
      "type": "integer"
    },
    "page_count": {
      "anyOf": [
        {
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Page Count"
    },
    "status": {
      "enum": [
        "text",
        "needs_ocr",
        "ocr_text",
        "empty",
        "low_quality",
        "locked",
        "restricted",
        "malformed",
        "missing",
        "limit",
        "unsupported",
        "cancelled",
        "timeout",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "text": {
      "default": "",
      "maxLength": 4000,
      "title": "Text",
      "type": "string"
    },
    "method": {
      "enum": [
        "pdfkit",
        "vision_pdf",
        "vision_image",
        "none"
      ],
      "title": "Method",
      "type": "string"
    },
    "engine_version": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Engine Version",
      "type": "string"
    },
    "quality": {
      "$ref": "#/$defs/StewardNativeTextQuality"
    },
    "languages_used": {
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
        "type": "string"
      },
      "maxItems": 8,
      "title": "Languages Used",
      "type": "array"
    },
    "languages_supported": {
      "items": {
        "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
        "type": "string"
      },
      "maxItems": 64,
      "title": "Languages Supported",
      "type": "array"
    },
    "reason": {
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "page",
    "status",
    "method",
    "engine_version",
    "reason"
  ],
  "title": "StewardNativeTextReceipt",
  "type": "object"
}
