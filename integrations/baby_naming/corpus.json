[
  {"id":"shijing-luming","branch":"object","title":"《诗经·小雅·鹿鸣》","text":"呦呦鹿鸣，食野之苹。我有嘉宾，鼓瑟吹笙。","url":"https://zh.wikisource.org/wiki/詩經/鹿鳴"},
  {"id":"shijing-jianjia","branch":"scene","title":"《诗经·秦风·蒹葭》","text":"蒹葭苍苍，白露为霜。所谓伊人，在水一方。","url":"https://zh.wikisource.org/wiki/詩經/蒹葭"},
